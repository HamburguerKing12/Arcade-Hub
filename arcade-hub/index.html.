<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090b14">
  <title>Arcade Hub</title>
  <style>
    :root{--bg:#090b14;--panel:#111522;--panel2:#171d2d;--text:#f4f6ff;--muted:#9aa4bd;--line:#252d42;--accent:#8b5cf6;--cyan:#22d3ee}
    *{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 15% -10%,#24204d 0,transparent 38%),radial-gradient(ellipse at 100% 10%,#103044 0,transparent 30%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}
    button,input{font:inherit}button{cursor:pointer}.wrap{max-width:1180px;margin:auto;padding:0 24px}
    header{border-bottom:1px solid #ffffff12;background:#090b14c9;backdrop-filter:blur(14px);position:sticky;top:0;z-index:5}
    .nav{height:74px;display:flex;align-items:center;justify-content:space-between;gap:20px}.brand{display:flex;align-items:center;gap:11px;font-weight:850;font-size:21px;letter-spacing:-.7px}.logo{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--cyan));display:grid;place-items:center;box-shadow:0 7px 25px #8b5cf655}.logo span{font-size:21px}
    .navtag{font-size:12px;color:#c7cce0;border:1px solid var(--line);padding:8px 12px;border-radius:99px}
    .hero{padding:58px 0 30px}.eyebrow{color:#a78bfa;text-transform:uppercase;font-size:11px;font-weight:800;letter-spacing:2px}.hero h1{font-size:clamp(38px,6vw,66px);line-height:1.02;letter-spacing:-2.8px;margin:12px 0}.hero h1 span{background:linear-gradient(90deg,#a78bfa,#67e8f9);-webkit-background-clip:text;background-clip:text;color:transparent}.hero p{color:var(--muted);max-width:590px;line-height:1.7;margin:0}
    .toolbar{display:flex;gap:12px;align-items:center;margin:28px 0 24px;flex-wrap:wrap}.search{flex:1;min-width:220px;position:relative}.search input{width:100%;background:var(--panel);border:1px solid var(--line);border-radius:13px;color:var(--text);padding:14px 16px 14px 43px;outline:none}.search input:focus{border-color:#8b5cf6}.search:before{content:"⌕";position:absolute;left:16px;top:8px;font-size:24px;color:var(--muted)}
    .filters{display:flex;gap:8px;flex-wrap:wrap}.filter{border:1px solid var(--line);color:#b9c1d7;background:var(--panel);border-radius:99px;padding:10px 14px;font-size:12px}.filter.active,.filter:hover{background:#302451;border-color:#7656c9;color:white}
    .sectionhead{display:flex;justify-content:space-between;align-items:end;margin:28px 0 16px}.sectionhead h2{font-size:20px;margin:0;letter-spacing:-.5px}.sectionhead small{color:var(--muted)}
    .grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;padding-bottom:55px}.game{background:linear-gradient(180deg,#171d2d,#101522);border:1px solid var(--line);border-radius:17px;overflow:hidden;transition:.2s;cursor:pointer}.game:hover{transform:translateY(-4px);border-color:#7255bd;box-shadow:0 15px 35px #0005}.cover{height:142px;display:grid;place-items:center;font-size:55px;position:relative;overflow:hidden}.cover:after{content:"";position:absolute;width:180px;height:180px;border:1px solid #ffffff20;border-radius:50%;right:-35px;top:-90px}.cover:before{content:"";position:absolute;width:120px;height:120px;border:1px solid #ffffff20;border-radius:50%;left:-40px;bottom:-80px}.cover span{filter:drop-shadow(0 8px 15px #0007);z-index:1}.gamebody{padding:14px}.gamebody h3{margin:0 0 6px;font-size:15px}.gamebody p{margin:0;color:var(--muted);font-size:12px;line-height:1.5}.meta{display:flex;justify-content:space-between;align-items:center;margin-top:13px}.tag{font-size:10px;color:#c4b5fd;background:#35265c;padding:5px 8px;border-radius:99px}.play{font-size:11px;color:#8be9f8;font-weight:750}
    .empty{grid-column:1/-1;text-align:center;padding:45px;color:var(--muted);background:var(--panel);border:1px dashed var(--line);border-radius:16px}
    footer{border-top:1px solid var(--line);padding:22px 0 35px;color:var(--muted);font-size:12px;line-height:1.6}
    .modal{display:none;position:fixed;inset:0;background:#03040bdc;z-index:10;padding:20px;align-items:center;justify-content:center}.modal.open{display:flex}.dialog{width:min(760px,100%);max-height:90vh;overflow:auto;background:#111725;border:1px solid #343d57;border-radius:20px;padding:20px;box-shadow:0 25px 90px #000a}.dialoghead{display:flex;justify-content:space-between;align-items:center;margin-bottom:14px}.dialoghead h2{margin:0;font-size:20px}.close{background:#252d42;color:white;border:0;border-radius:10px;padding:8px 12px}.gamearea{min-height:300px;background:#090d18;border:1px solid var(--line);border-radius:14px;padding:18px;display:grid;place-items:center;text-align:center}.gamearea button,.action{border:0;border-radius:10px;padding:11px 16px;color:white;font-weight:750;background:linear-gradient(90deg,#7651d5,#287e9a)}.hint{color:var(--muted);font-size:12px;margin-top:12px}
    #snakeCanvas{max-width:100%;background:#080d17;border:1px solid #2c3650;border-radius:8px}.ttt{display:grid;grid-template-columns:repeat(3,85px);gap:8px}.ttt button{height:85px;font-size:32px;background:#1b2440;border:1px solid #394566;border-radius:12px;color:white}.score{font-size:26px;font-weight:800;margin:12px}
    @media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:650px){.wrap{padding:0 16px}.nav{height:64px}.hero{padding-top:42px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:11px}.cover{height:112px;font-size:44px}.navtag{display:none}}@media(max-width:390px){.grid{grid-template-columns:1fr}.cover{height:135px}}
  </style>
</head>
<body>
<header><div class="wrap nav"><div class="brand"><div class="logo"><span>🎮</span></div>ARCADE HUB</div><div class="navtag">YOUR MINI ARCADE</div></div></header>
<main class="wrap">
  <section class="hero"><div class="eyebrow">PLAY • EXPLORE • REPEAT</div><h1>Your next game<br>is <span>right here.</span></h1><p>A collection of quick browser games for breaks, challenges, and a little friendly competition. Pick a game and jump in.</p></section>
  <div class="toolbar"><div class="search"><input id="search" type="search" placeholder="Search games..." aria-label="Search games"></div><div class="filters" id="filters"></div></div>
  <div class="sectionhead"><h2>All games</h2><small id="count"></small></div>
  <section class="grid" id="grid"></section>
</main>
<footer><div class="wrap">Arcade Hub · A personal browser-game project. Use games where permitted and follow the rules of the network you're using. Some games open on their creators’ or hosting sites in a new tab. More games can be added by editing the game list in <b>index.html</b>.</div></footer>
<div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle"><div class="dialog"><div class="dialoghead"><h2 id="modalTitle">Game</h2><button class="close" id="close">Close ✕</button></div><div class="gamearea" id="gamearea"></div></div></div>
<script>
const games=[
 {id:"snake",name:"Neon Snake",category:"Arcade",desc:"Eat the dots, grow longer, and avoid yourself.",emoji:"🐍",bg:"linear-gradient(135deg,#075e55,#102a45)",type:"built"},
 {id:"tic",name:"Tic-Tac-Toe",category:"Puzzle",desc:"A classic two-player strategy game.",emoji:"⭕",bg:"linear-gradient(135deg,#492c83,#1c315d)",type:"built"},
 {id:"reaction",name:"Reaction Rush",category:"Skill",desc:"Test how quickly you can react to the signal.",emoji:"⚡",bg:"linear-gradient(135deg,#9b3d36,#54244d)",type:"built"},
 {id:"memory",name:"Memory Match",category:"Puzzle",desc:"Flip cards and find all matching pairs.",emoji:"🧠",bg:"linear-gradient(135deg,#235a9a,#34245e)",type:"built"},
 {id:"clicker",name:"Star Clicker",category:"Arcade",desc:"Collect stars and beat your high score.",emoji:"🌟",bg:"linear-gradient(135deg,#87501d,#4c2865)",type:"built"},
 {id:"pong",name:"Mini Pong",category:"Sports",desc:"Keep the ball in play against the computer.",emoji:"🏓",bg:"linear-gradient(135deg,#12605f,#26336c)",type:"built"},
 {id:"runner",name:"Pixel Runner",category:"Action",desc:"Jump over obstacles and keep moving.",emoji:"🏃",bg:"linear-gradient(135deg,#8b4c24,#49305f)",type:"built"},
 {id:"number",name:"Number Grid",category:"Puzzle",desc:"A quick number puzzle for your brain.",emoji:"🔢",bg:"linear-gradient(135deg,#285b86,#42306e)",type:"built"},
 {id:"panic",name:"! PANIC !",category:"Action",desc:"Survive as long as you can in this fast arcade challenge.",emoji:"🚀",bg:"linear-gradient(135deg,#9b3434,#4a245e)",url:"https://poppants.itch.io/panic"},
 {id:"pixelspeed",name:"Pixel Speedrun",category:"Platformer",desc:"Race through pixel levels, dodge hazards, and chase your best time.",emoji:"🟪",bg:"linear-gradient(135deg,#5b3c9a,#173b66)",url:"https://pixelspeedrun.com/"},
 {id:"ovo",name:"OvO",category:"Platformer",desc:"Run, jump, slide, and dive through precision platforming levels.",emoji:"🏃",bg:"linear-gradient(135deg,#247a9a,#39306e)",url:"https://www.crazygames.com/game/ovo-online"},
 {id:"eaglercraft",name:"Eaglercraft",category:"Survival",desc:"A browser-based block-building game. Choose a version on its site.",emoji:"⛏️",bg:"linear-gradient(135deg,#397348,#243c64)",url:"https://eaglercraft.com/play"}
];
const cats=["All","Arcade","Action","Platformer","Survival","Sports","Puzzle","Skill"];let active="All";
const grid=document.getElementById("grid"),filters=document.getElementById("filters"),search=document.getElementById("search");
function renderFilters(){filters.innerHTML=cats.map(c=>`<button class="filter ${active===c?'active':''}" data-cat="${c}">${c}</button>`).join("");filters.querySelectorAll("button").forEach(b=>b.onclick=()=>{active=b.dataset.cat;renderFilters();render()})}
function render(){let q=search.value.toLowerCase();let list=games.filter(g=>(active==="All"||g.category===active)&&(g.name+" "+g.desc+" "+g.category).toLowerCase().includes(q));document.getElementById("count").textContent=`${list.length} games`;grid.innerHTML=list.length?list.map(g=>`<article class="game" data-id="${g.id}" tabindex="0"><div class="cover" style="background:${g.bg}"><span>${g.emoji}</span></div><div class="gamebody"><h3>${g.name}</h3><p>${g.desc}</p><div class="meta"><span class="tag">${g.category}</span><span class="play">PLAY NOW ↗</span></div></div></article>`).join(""):`<div class="empty">No games found. Try another search.</div>`;grid.querySelectorAll(".game").forEach(el=>{el.onclick=()=>launch(el.dataset.id);el.onkeydown=e=>{if(e.key==="Enter")launch(el.dataset.id)}})}
search.addEventListener("input",render);renderFilters();render();
const modal=document.getElementById("modal"),area=document.getElementById("gamearea");
document.getElementById("close").onclick=closeGame;modal.onclick=e=>{if(e.target===modal)closeGame()};document.addEventListener("keydown",e=>{if(e.key==="Escape")closeGame()});
function closeGame(){modal.classList.remove("open");area.innerHTML=""}
function launch(id){let g=games.find(x=>x.id===id);if(g.url){window.open(g.url,"_blank","noopener,noreferrer");return}document.getElementById("modalTitle").textContent=g.name;modal.classList.add("open");({snake:snakeGame,tic:ticGame,reaction:reactionGame,memory:memoryGame,clicker:clickerGame,pong:pongGame,runner:runnerGame,number:numberGame})[id]()}
function snakeGame(){area.innerHTML=`<div><p>Use arrow keys or WASD. Eat the green dots.</p><canvas id="snakeCanvas" width="420" height="300"></canvas><div class="score" id="snakeScore">Score: 0</div><button id="snakeStart">Start / Restart</button><p class="hint">The game ends if you hit a wall or yourself.</p></div>`;let c=document.getElementById("snakeCanvas"),ctx=c.getContext("2d"),snake,food,dir,score,timer;function reset(){clearInterval(timer);snake=[{x:10,y:7},{x:9,y:7},{x:8,y:7}];dir={x:1,y:0};score=0;food={x:15,y:7};document.getElementById("snakeScore").textContent="Score: 0";draw();timer=setInterval(step,115)}function draw(){ctx.fillStyle="#080d17";ctx.fillRect(0,0,420,300);ctx.fillStyle="#34d399";ctx.fillRect(food.x*20,food.y*20,17,17);snake.forEach((p,i)=>{ctx.fillStyle=i?"#38bdf8":"#a78bfa";ctx.fillRect(p.x*20,p.y*20,17,17)})}function step(){let h={x:snake[0].x+dir.x,y:snake[0].y+dir.y};if(h.x<0||h.y<0||h.x>=21||h.y>=15||snake.some(p=>p.x===h.x&&p.y===h.y)){clearInterval(timer);ctx.fillStyle="#fff";ctx.font="22px sans-serif";ctx.fillText("Game over",155,150);return}snake.unshift(h);if(h.x===food.x&&h.y===food.y){score++;document.getElementById("snakeScore").textContent="Score: "+score;food={x:Math.floor(Math.random()*21),y:Math.floor(Math.random()*15)}}else snake.pop();draw()}document.onkeydown=e=>{let k=e.key.toLowerCase(),d={arrowup:[0,-1],w:[0,-1],arrowdown:[0,1],s:[0,1],arrowleft:[-1,0],a:[-1,0],arrowright:[1,0],d:[1,0]}[k];if(d&&!(d[0]===-dir.x&&d[1]===-dir.y)){dir={x:d[0],y:d[1]};e.preventDefault()}};document.getElementById("snakeStart").onclick=reset;reset()}
function ticGame(){area.innerHTML=`<div><p>Take turns. X goes first.</p><div class="ttt" id="ttt"></div><div class="score" id="tttStatus">X's turn</div><button id="tttReset">New round</button></div>`;let board=Array(9).fill(""),turn="X",done=false;function draw(){let el=document.getElementById("ttt");el.innerHTML=board.map((v,i)=>`<button data-i="${i}">${v}</button>`).join("");el.querySelectorAll("button").forEach(b=>b.onclick=()=>move(+b.dataset.i));}function move(i){if(done||board[i])return;board[i]=turn;let win=[[0,1,2],[3,4,5],[6,7,8],[0,3,6],[1,4,7],[2,5,8],[0,4,8],[2,4,6]].some(a=>a.every(n=>board[n]===turn));if(win){document.getElementById("tttStatus").textContent=turn+" wins!";done=true}else if(board.every(Boolean)){document.getElementById("tttStatus").textContent="It's a draw!";done=true}else{turn=turn==="X"?"O":"X";document.getElementById("tttStatus").textContent=turn+"'s turn"}draw()}document.getElementById("tttReset").onclick=()=>{board=Array(9).fill("");turn="X";done=false;document.getElementById("tttStatus").textContent="X's turn";draw()};draw()}
function reactionGame(){area.innerHTML=`<div><p>Press start, wait for green, then click as fast as possible.</p><div id="reactBox" style="width:min(430px,75vw);height:170px;border-radius:15px;background:#39415b;display:grid;place-items:center;font-size:20px;font-weight:800">Ready?</div><div class="score" id="reactScore">Your time: —</div><button id="reactStart">Start</button><p class="hint">Don't click early.</p></div>`;let box=document.getElementById("reactBox"),score=document.getElementById("reactScore"),start=document.getElementById("reactStart"),timer,ready=false,begin=0;start.onclick=()=>{clearTimeout(timer);ready=false;box.style.background="#39415b";box.textContent="Wait for green...";score.textContent="Your time: —";start.disabled=true;timer=setTimeout(()=>{ready=true;begin=performance.now();box.style.background="#087b55";box.textContent="CLICK!";},1000+Math.random()*3000)};box.onclick=()=>{if(!ready){if(start.disabled){clearTimeout(timer);box.textContent="Too soon!";box.style.background="#9b3434";start.disabled=false}return}score.textContent="Your time: "+Math.round(performance.now()-begin)+" ms";box.textContent="Nice reaction!";ready=false;start.disabled=false}}
function memoryGame(){area.innerHTML=`<div><p>Find all 4 matching pairs.</p><div id="memory" style="display:grid;grid-template-columns:repeat(4,65px);gap:8px"></div><div class="score" id="memoryStatus">Moves: 0</div><button id="memoryReset">Shuffle</button></div>`;let vals=["🍉","🚀","🎧","🐸","🍉","🚀","🎧","🐸"],open=[],matched=[],moves=0;function draw(){let el=document.getElementById("memory");el.innerHTML=vals.map((v,i)=>`<button data-i="${i}" style="height:65px;font-size:25px;border-radius:10px;border:1px solid #3a4662;background:#202a43;color:white">${matched.includes(i)||open.includes(i)?v:"?"}</button>`).join("");el.querySelectorAll("button").forEach(b=>b.onclick=()=>flip(+b.dataset.i))}function flip(i){if(open.length===2||open.includes(i)||matched.includes(i))return;open.push(i);draw();if(open.length===2){moves++;document.getElementById("memoryStatus").textContent="Moves: "+moves;if(vals[open[0]]===vals[open[1]]){matched.push(...open);open=[];draw();if(matched.length===8)document.getElementById("memoryStatus").textContent="Completed in "+moves+" moves!"}else setTimeout(()=>{open=[];draw()},650)}}document.getElementById("memoryReset").onclick=()=>{vals.sort(()=>Math.random()-.5);open=[];matched=[];moves=0;document.getElementById("memoryStatus").textContent="Moves: 0";draw()};vals.sort(()=>Math.random()-.5);draw()}
function clickerGame(){area.innerHTML=`<div><p>Click the star as many times as you can in 10 seconds.</p><div class="score" id="clickScore">0</div><button id="star" style="font-size:45px;padding:20px 35px">🌟</button><p id="clickTime">Press start when ready.</p><button id="clickStart">Start 10 seconds</button></div>`;let n=0,left=10,t;document.getElementById("star").onclick=()=>{if(left>0){n++;document.getElementById("clickScore").textContent=n}};document.getElementById("clickStart").onclick=()=>{clearInterval(t);n=0;left=10;document.getElementById("clickScore").textContent=0;document.getElementById("clickTime").textContent="10 seconds left";t=setInterval(()=>{left--;document.getElementById("clickTime").textContent=left+" seconds left";if(left<=0){clearInterval(t);document.getElementById("clickTime").textContent="Time! Final score: "+n}},1000)}}
function pongGame(){area.innerHTML=`<div><p>Move your mouse over the game or use ↑ and ↓. First to 5 wins.</p><canvas id="pong" width="520" height="300" style="max-width:100%;background:#080d17;border:1px solid #2c3650;border-radius:8px"></canvas><div id="pongScore" class="score">0 : 0</div><button id="pongStart">Start / Restart</button></div>`;let c=document.getElementById("pong"),x=c.getContext("2d"),py=110,cy=110,bx=260,by=150,vx=4,vy=3,p=0,ai=0,t,run=false;function draw(){x.fillStyle="#080d17";x.fillRect(0,0,520,300);x.setLineDash([6,8]);x.strokeStyle="#34415e";x.beginPath();x.moveTo(260,0);x.lineTo(260,300);x.stroke();x.setLineDash([]);x.fillStyle="#a78bfa";x.fillRect(15,py,9,80);x.fillStyle="#22d3ee";x.fillRect(496,cy,9,80);x.fillStyle="white";x.fillRect(bx,by,10,10)}function step(){bx+=vx;by+=vy;if(by<0||by>290)vy*=-1;if(bx<24&&by>py&&by<py+80)vx=Math.abs(vx)*1.04;if(bx>490&&by>cy&&by<cy+80)vx=-Math.abs(vx)*1.04;cy+=((by-40)-cy)*.075;cy=Math.max(0,Math.min(220,cy));if(bx<0){ai++;resetBall()}if(bx>520){p++;resetBall()}document.getElementById("pongScore").textContent=p+" : "+ai;if(p>=5||ai>=5){clearInterval(t);run=false;document.getElementById("pongScore").textContent=p+" : "+ai+" · "+(p>ai?"You win!":"Computer wins!")}draw()}function resetBall(){bx=260;by=150;vx=p>ai?-4:4;vy=(Math.random()>.5?3:-3)}c.onmousemove=e=>{let r=c.getBoundingClientRect();py=Math.max(0,Math.min(220,(e.clientY-r.top)*300/r.height-40))};document.onkeydown=e=>{if(e.key==="ArrowUp")py=Math.max(0,py-22);if(e.key==="ArrowDown")py=Math.min(220,py+22)};document.getElementById("pongStart").onclick=()=>{clearInterval(t);p=ai=0;resetBall();run=true;t=setInterval(step,20)};draw()}
function runnerGame(){area.innerHTML=`<div><p>Press space, ↑, or tap to jump over the blocks.</p><canvas id="runner" width="520" height="220" style="max-width:100%;background:#101a2b;border:1px solid #2c3650;border-radius:8px"></canvas><div class="score" id="runScore">Score: 0</div><button id="runStart">Start / Restart</button></div>`;let c=document.getElementById("runner"),x=c.getContext("2d"),y=0,vy=0,obs=[],score=0,alive=false,t;function jump(){if(alive&&y===0)vy= -10}function draw(){x.fillStyle="#101a2b";x.fillRect(0,0,520,220);x.fillStyle="#52617e";x.fillRect(0,185,520,3);x.fillStyle="#a78bfa";x.fillRect(65,155-y,25,30);x.fillStyle="#22d3ee";obs.forEach(o=>x.fillRect(o.x,160,o.w,25));x.fillStyle="white";x.font="14px sans-serif";x.fillText("SPACE / TAP TO JUMP",350,25)}function step(){vy+=.55;y=Math.max(0,y+vy);if(y===0)vy=0;if(Math.random()<.035)obs.push({x:520,w:18+Math.random()*15});obs.forEach(o=>o.x-=5);obs=obs.filter(o=>o.x>-30);if(obs.some(o=>o.x<90&&o.x+o.w>65&&y<25)){alive=false;clearInterval(t)}else score++;document.getElementById("runScore").textContent="Score: "+Math.floor(score/5)+(alive?"":" · Game over");draw()}document.onkeydown=e=>{if(e.code==="Space"||e.key==="ArrowUp"){jump();e.preventDefault()}};c.onclick=jump;document.getElementById("runStart").onclick=()=>{clearInterval(t);y=0;vy=0;obs=[];score=0;alive=true;t=setInterval(step,25)};draw()}
function numberGame(){area.innerHTML=`<div><p>Use the arrow keys to combine tiles. Reach 512 to win.</p><div id="nums" style="display:grid;grid-template-columns:repeat(4,65px);gap:7px"></div><div class="score" id="numStatus">Score: 0</div><button id="numReset">New game</button></div>`;let b=Array(16).fill(0),s=0;function add(){let z=b.map((v,i)=>v?null:i).filter(v=>v!==null);if(z.length)b[z[Math.floor(Math.random()*z.length)]]=Math.random()<.85?2:4}function draw(){document.getElementById("nums").innerHTML=b.map(v=>`<div style="height:65px;display:grid;place-items:center;border-radius:9px;background:${v?"#57448c":"#202a3e"};font-size:20px;font-weight:800">${v||""}</div>`).join("");document.getElementById("numStatus").textContent="Score: "+s+(b.includes(512)?" · You win!":"")}function move(dir){let old=b.join(",");for(let k=0;k<4;k++){let ids=dir==="left"?[0,1,2,3].map(j=>k*4+j):dir==="right"?[3,2,1,0].map(j=>k*4+j):dir==="up"?[0,1,2,3].map(j=>j*4+k):[3,2,1,0].map(j=>j*4+k);let a=ids.map(i=>b[i]).filter(Boolean),out=[];for(let i=0;i<a.length;i++){if(a[i]===a[i+1]){out.push(a[i]*2);s+=a[i]*2;i++}else out.push(a[i])}while(out.length<4)out.push(0);ids.forEach((id,j)=>b[id]=out[j])}if(old!==b.join(","))add();draw()}document.onkeydown=e=>{if(["ArrowLeft","ArrowRight","ArrowUp","ArrowDown"].includes(e.key)){move(e.key.slice(5).toLowerCase());e.preventDefault()}};document.getElementById("numReset").onclick=()=>{b=Array(16).fill(0);s=0;add();add();draw()};add();add();draw()}
</script>
</body>
</html>
